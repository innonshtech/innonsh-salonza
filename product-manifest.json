{
  "productId": "innonsh-salon",
  "productName": "Innonsh Salon Management",
  "version": "0.1.0",
  "description": "Comprehensive Salon Management System for Innonsh Clients",
  "application": {
    "frontendFramework": "React",
    "backendFramework": "Next.js App Router",
    "database": "MongoDB"
  },
  "commands": {
    "install": "npm install",
    "build": "npm run build",
    "start": "npm run start",
    "migrate": "echo 'MongoDB does not require migrations'",
    "seed": "echo 'No standard seed script configured'",
    "test": "npm run lint"
  },
  "deployment": {
    "type": "vercel",
    "healthEndpoint": "/api/system/health"
  },
  "authentication": {
    "supportsAdminCreation": true,
    "createAdminEndpoint": "/api/system/create-admin"
  },
  "storage": {
    "provider": "local"
  },
  "features": [
    "Bookings & Appointments",
    "Clients Management",
    "Staff & Operations",
    "Services & Catalog",
    "Products & Inventory",
    "Sales & Billing",
    "Marketing & Campaigns",
    "Memberships"
  ]
}
